#!name=抖音去水印·最高画质下载 V2
#!desc=保持正常自适应播放，仅将抖音下载地址替换为可用的最高画质源，并解除常见下载限制。notify=true 时弹出通知。
#!author=FearPotatoMine
#!homepage=https://github.com/FearPotatoMine/Apple-Rule
#!arguments=notify:false
#!arguments-desc=notify: 替换成功时是否弹出通知(true/false)

[Rule]
# 禁用抖音相关 QUIC，使 HTTPS 流量可被 MITM 脚本处理
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-KEYWORD,amemv)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-KEYWORD,snssdk)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-KEYWORD,douyin)),REJECT-NO-DROP

[Script]
http-response ^https?:\/\/(aweme|api\d*|aweme-[a-z0-9-]+)\.(amemv|snssdk)\.com\/aweme\/v\d\/(feed|aweme\/detail|multi\/aweme\/detail|aweme\/post|aweme\/favorite|mix\/aweme|hot\/search\/video\/list|general\/search\/single|search\/item|familiar\/feed|follow\/feed|nearby\/feed)\/? script-path=https://raw.githubusercontent.com/FearPotatoMine/Apple-Rule/refs/heads/main/douyin_nowm_v2.js, requires-body=true, max-size=0, timeout=10, tag=抖音去水印V2, argument=notify=[{notify}]

[MITM]
hostname = %APPEND% aweme.snssdk.com, *.snssdk.com, *.amemv.com, api*.amemv.com, aweme-*.amemv.com
